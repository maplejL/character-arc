{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "paths": {
      "@/*": ["../renderer/src/*"],
      "@shared/*": ["../electron/shared/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "../renderer/src/**/*.ts", "../renderer/src/**/*.vue"]
}
